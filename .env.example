# Environment variables (copy to .env.local — never commit secrets)

# App
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Backend (Phase 1+) — Supabase recommended
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Email (Phase 3+) — SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdojang.com

# Video storage (Phase 4+) — often same as Supabase Storage or S3
# VITE_STORAGE_BUCKET=
