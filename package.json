{
  "name": "dojang-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "npm run build && npx lighthouse http://127.0.0.1:4173 --only-categories=performance,accessibility,best-practices --chrome-flags=\"--headless\" --preset=desktop --output=html --output-path=./lighthouse-report.html",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
